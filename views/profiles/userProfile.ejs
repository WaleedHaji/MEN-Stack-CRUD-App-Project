<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
</head>
<body>
    
    <%- include('../partials/navbar') %>

    <h1>User Profile</h1>

    <h2> <%= user.username %>'s Profile </h2>
    <a href="/userprofile/edit">Edit Profile</a>

    <% if(user.userRole === 'dog'){ %> 

         <p>Breed: <%= profile.breed %></p>
         <p>Age: <%= profile.age %></p>
         <p>Personality: <%= profile.personality %></p>
         <p>Size: <%= profile.size %></p>
         <p>Description: <%= profile.descriptionOwner %></p>
         
        <% }else{ %>
         <p>Full Name: <%= profile.firstName %> <%= profile.lastName %></p>
         <p>Walker License No.: <%= profile.walkerLicenseNo %></p>
         <p>Description: <%= profile.description %></p>

        <% }%>
      

   
     
   




