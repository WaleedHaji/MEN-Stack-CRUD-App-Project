<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile</title>
</head>
<body>


<%- include('../partials/navbar') %>

<h1>Edit Profile</h1>

<% if (user.userRole === 'dog') { %>

    <form action="/userprofile/dog/<%= profile._id %>/edit?_method=PUT" method="POST">

        <div id="owner-form">

            <label for="nameInput">Name:</label>
            <input
                id="nameInput"
                name="name"
                type="text"
                value="<%= profile.name || '' %>"
            >

            <label for="breedInput">Breed:</label>
            <input
                id="breedInput"
                name="breed"
                type="text"
                value="<%= profile.breed || '' %>"
            >

            <label for="ageInput">Age:</label>
            <input
                id="ageInput"
                name="age"
                type="number"
                value="<%= profile.age || '' %>"
            >

            <label for="personalityInput">Personality:</label>
            <select name="personality" id="personalityInput">
                <option value="friendly" <%= profile.personality === 'friendly' ? 'selected' : '' %>>
                    Friendly
                </option>
                <option value="shy" <%= profile.personality === 'shy' ? 'selected' : '' %>>
                    Shy
                </option>
                <option value="aggressive" <%= profile.personality === 'aggressive' ? 'selected' : '' %>>
                    Aggressive
                </option>
                <option value="neutral" <%= profile.personality === 'neutral' ? 'selected' : '' %>>
                    Neutral
                </option>
                <option value="hyper" <%= profile.personality === 'hyper' ? 'selected' : '' %>>
                    Hyper
                </option>
            </select>

            <label for="sizeInput">Size:</label>
            <select name="size" id="sizeInput">
                <option value="small" <%= profile.size === 'small' ? 'selected' : '' %>>
                    Small
                </option>
                <option value="medium" <%= profile.size === 'medium' ? 'selected' : '' %>>
                    Medium
                </option>
                <option value="large" <%= profile.size === 'large' ? 'selected' : '' %>>
                    Large
                </option>
            </select>

            <label for="descriptionInput">Description:</label>
            <input
                id="descriptionInput"
                name="descriptionOwner"
                type="text"
                value="<%= profile.descriptionOwner || '' %>"
            >

        </div>

        <button type="submit">Save Changes</button>

    </form>

<% } else if (user.userRole === 'dogWalker') { %>

    <form action="/userprofile/edit?_method=PUT" method="POST">

        <div id="walker-form">

            <label for="firstNameInput">First Name:</label>
            <input
                id="firstNameInput"
                name="firstName"
                type="text"
                value="<%= profile.firstName || '' %>"
            >

            <label for="lastNameInput">Last Name:</label>
            <input
                id="lastNameInput"
                name="lastName"
                type="text"
                value="<%= profile.lastName || '' %>"
            >

            <label for="descriptionInput">Description:</label>
            <input
                id="descriptionInput"
                name="description"
                type="text"
                value="<%= profile.description || '' %>"
            >

        </div>

        <button type="submit">Save Changes</button>

    </form>

<% } %>


</body>
</html>
