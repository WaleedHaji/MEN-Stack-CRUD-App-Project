<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <title>Request a Walk</title>
</head>
<body>


<%- include('../partials/navbar') %>

<h1>Request a Dog Walk</h1>


<form action="/walks/request" method="POST">

    <h2>Choose your dogs</h2>

    <% if (dogs.length === 0) { %>

        <p>You don't have any dogs yet.</p>

        <a href="/userprofile/add-dog">
            Add a Dog
        </a>

    <% } else { %>

        <% for (dog of dogs) { %>

            <div>
                <input
                    type="checkbox"
                    id="dog-<%= dog._id %>"
                    name="dogs"
                    value="<%= dog._id %>"
                >

                <label for="dog-<%= dog._id %>">
                    <%= dog.name %>
                </label>
            </div>

        <% } %>

    <% } %>


    <h2>Choose a Walker</h2>

    <% if (walkers.length === 0) { %>

        <p>There are currently no Walkers available.</p>

    <% } else { %>

        <% walkers.forEach(function(walker) { %>

            <div>
                <input
                    type="radio"
                    id="walker-<%= walker.owner._id %>"
                    name="walker"
                    value="<%= walker.owner._id %>"
                    required
                >

                <label for="walker-<%= walker.owner._id %>">
                    <%= walker.firstName %> <%= walker.lastName %>
                </label>

                <% if (walker.description) { %>
                    <p><%= walker.description %></p>
                <% } %>

            </div>

        <% }) %>

    <% } %>


    <h2>Walk Duration</h2>

    <select name="duration" required>

        <option value="">Choose a duration</option>

        <option value="15">
            15 minutes
        </option>

        <option value="30">
            30 minutes
        </option>

        <option value="45">
            45 minutes
        </option>

        <option value="60">
            1 hour
        </option>

        <option value="90">
            1 hour 30 minutes
        </option>

    </select>


    <br><br>

    <button type="submit">
        Request Walk
    </button>

</form>


</body>
</html>
