<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up</title>
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <h1>Create a new account!</h1>
    <form action="/auth/sign-up" method="post">

      <label for="username">Username:</label>
      <input type="text" name="username" id="username" />

      <label for="password">Password:</label>
      <input type="password" name="password" id="password" />

      <label for="confirmPassword">Confirm Password:</label>
      <input type="password" name="confirmPassword" id="confirmPassword" />

      <label for="userRole">User Role:</label>
      <select name="userRole" id="userRole">
        <option value="" disabled selected>-Select one-</option>
        <option value="dog">Dog</option>
        <option value="dogWalker">Dog Walker</option>
      </select>

      <div style="display: none;" id="walker-form">
        <label for="firstNameInput">First Name:</label>
        <input id="firstNameInput" name="firstName" type="text">

        <label for="lastNameInput">Last Name:</label>
        <input id="lastNameInput" name="lastName" type="text">

        <label for="licenseNoInput">Walker License Number:</label>
        <input id="licenseNoInput" name="walkerLicenseNo" type="text">

        <label for="descriptionInput">Description:</label>
        <input id="descriptionInput" name="description" type="text">

        <label for="crpNumberInput">CPR:</label>
        <input id="licenseNoInput" name="cprNumber" type="text">

        <label for="idVerificationinput">Upload file:</label>
        <input id="idVerificationinput" name="idVerification" type="file" accept=".png, .jpg, .jpeg">
      </div>

      <div style="display: none;" id="owner-form">
        <label for="breedInput">Breed:</label>
        <input id="breedInput" name="breed" type="text">

        <label for="ageInput">Age:</label>
        <input id="ageInput" name="age" type="number">

        <label for="personalityInput">Personality:</label>
        <select name="personality" id="personalityInput">
            <option value="" disabled selected>-Select one-</option>
            <option value="friendly">Friendly</option>
            <option value="shy">Shy</option>
            <option value="aggressive">Aggressive</option>
            <option value="neutral">Neutral</option>
            <option value="hyper">Hyper</option>
        </select>
       

        <label for="sizeInput">Size:</label>
        <select name="size" id="sizeInput">
            <option value="" disabled selected>-Select one-</option>
            <option value="small">Small</option>
            <option value="medium">Medium</option>
            <option value="large">Large</option>
        </select>

        <label for="descriptionInput">Description:</label>
        <input id="descriptionInput" name="descriptionOwner" type="text">
      </div>

      <button type="submit">Sign up</button>
    </form>


    <script>
      const typeSelect = document.querySelector('#userRole')
      const ownerElement = document.querySelector('#owner-form')
      const walkerElement = document.querySelector('#walker-form')

      function showForm(event){
        if(typeSelect.value=='dog'){
          ownerElement.style.display = 'block'
          walkerElement.style.display = 'none'
        }else if(typeSelect.value=='dogWalker'){
          ownerElement.style.display = 'none'
          walkerElement.style.display = 'block'
        }
      }

      typeSelect.addEventListener('change',showForm)
    </script>
  </body>
</html>
